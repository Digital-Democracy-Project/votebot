# Non-secret settings for the production container (VOTEBOT-14). Merged into /opt/votebot/.env by
# infrastructure/render-env.sh. NEVER put a secret here: the script refuses a secret name.
ENVIRONMENT=production
PINECONE_INDEX_NAME=ddp-knowledge-base
PINECONE_NAMESPACE=default
DDP_BROKER_API_ROOT=https://mapapp.digitaldemocracyproject.org
USE_DDP_OPENSTATES_REPLICA=true
DDP_OPENSTATES_API_ROOT=http://10.0.0.11:8002
DDP_OPENSTATES_AUTH_HEADER=x-api-key
DDP_SITE_BASE_URL=https://dev.digitaldemocracyproject.org
ALLOWED_ORIGINS=["https://dev.digitaldemocracyproject.org"]
REDIS_URL=redis://votebot-redis:6379/0
QUERY_LOG_DIR=/app/logs/queries
VOTEBOT_QUICK_ACTION_BUTTONS=false
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
