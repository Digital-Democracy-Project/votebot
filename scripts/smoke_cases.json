[
  {
    "name": "FL",
    "discover": {
      "jurisdiction": "FL"
    },
    "questions": [
      {
        "message": "What does this bill do?",
        "min_citations": 1
      },
      {
        "message": "Which version of the bill text are you answering from, and what is its date?",
        "expect_any": [
          "introduced",
          "engrossed",
          "enrolled",
          "chaptered",
          "amendment",
          "passed"
        ],
        "expect_regex": [
          "\\d{4}-\\d{2}-\\d{2}",
          "(January|February|March|April|May|June|July|August|September|October|November|December) \\d{1,2}, \\d{4}"
        ]
      },
      {
        "message": "How did the vote on this bill go?",
        "expect_votes_tool": true
      }
    ],
    "expect_types": [
      "bill-text"
    ]
  },
