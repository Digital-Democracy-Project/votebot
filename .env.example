# VoteBot Environment Configuration
# Copy this file to .env and fill in your values

# Application
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
API_KEY=your-api-key-here

# OpenAI
OPENAI_API_KEY=sk-your-openai-key
OPENAI_MODEL=gpt-4.1
OPENAI_EMBEDDING_MODEL=text-embedding-3-large

# Web Search (Responses API)
WEB_SEARCH_ENABLED=true
WEB_SEARCH_CONTEXT_SIZE=medium
WEB_SEARCH_ON_LOW_CONFIDENCE=true
WEB_SEARCH_CONFIDENCE_THRESHOLD=0.5

# Pinecone
PINECONE_API_KEY=your-pinecone-key
PINECONE_ENVIRONMENT=us-east-1
# The index name also decides the bill filter key: `votebot-large` is keyed by webflow_id, any other
# index (e.g. ddp-knowledge-base) by ocd_bill_id. Rolling back is changing this one value.
PINECONE_INDEX_NAME=votebot-large
PINECONE_NAMESPACE=default

# Redis (optional, for caching)
REDIS_URL=redis://localhost:6379/0

# PostgreSQL (optional)
DATABASE_URL=postgresql://votebot:password@localhost:5432/votebot

# External APIs
CONGRESS_API_KEY=your-congress-api-key
OPENSTATES_API_KEY=your-openstates-api-key

# DDP-replica OpenStates routing (VOTEBOT-2) — set all three together, or
# leave unset to keep using the public API above. USE_DDP_OPENSTATES_REPLICA
# defaults to false; DDP_OPENSTATES_API_ROOT has no code default at all, so it
# must be set explicitly here once the flag is on.
USE_DDP_OPENSTATES_REPLICA=false
DDP_OPENSTATES_API_ROOT=https://api.digitaldemocracyproject.org/openstates
DDP_OPENSTATES_BEARER_TOKEN=your-ddp-api-issued-read-key
# How that credential is sent: "bearer" (default) for ddp-api's proxy, "x-api-key" when DDP_OPENSTATES_API_ROOT
# is api-v3 itself (it accepts only an X-API-Key header and answers 403 to a Bearer token).
DDP_OPENSTATES_AUTH_HEADER=bearer

# ddp-broker-py (VOTEBOT-8): /content/resolve uses it for ddp-next bill URLs, and (canonical index) it is where
# organization positions and organization profiles are read at query time. No code default.
DDP_BROKER_API_ROOT=

# Our own site (ddp-next), e.g. https://digitaldemocracyproject.org. When set (canonical index only), bill sources
# and citations link to {base}/explore/{JURISDICTION}/{SESSION}/{IDENTIFIER}. No default host; unset = unchanged.
DDP_SITE_BASE_URL=

# VOTEBOT-21: when the model writes no [Source: ...], cite the retrieved chunks the answer was built from.
# Default true; false returns only the citations the model wrote.
# VOTEBOT_DETERMINISTIC_CITATIONS=true

# Switch for the runtime organization-position lookups (Webflow on the legacy index, the broker on the canonical one).
WEBFLOW_ORG_LOOKUP_ENABLED=true

# Webflow CMS
WEBFLOW_VOTEBOT_API_KEY=your-webflow-read-only-api-key
WEBFLOW_SCHEDULER_API_KEY=your-webflow-read-write-api-key
WEBFLOW_SITE_ID=your-webflow-site-id
WEBFLOW_BILLS_COLLECTION_ID=your-bills-collection-id
WEBFLOW_JURISDICTION_COLLECTION_ID=your-jurisdiction-collection-id
WEBFLOW_LEGISLATORS_COLLECTION_ID=your-legislators-collection-id
WEBFLOW_CATEGORIES_COLLECTION_ID=your-categories-collection-id
WEBFLOW_ORGANIZATIONS_COLLECTION_ID=your-organizations-collection-id

# RAG Configuration
CHUNK_SIZE=750
CHUNK_OVERLAP=150
MAX_RETRIEVAL_CHUNKS=10
SIMILARITY_THRESHOLD=0.1

# Performance
REQUEST_TIMEOUT_SECONDS=30
MAX_CONCURRENT_REQUESTS=1000

# AWS (for production deployment)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Slack Integration (for human handoff)
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_APP_TOKEN=xapp-your-app-token
SLACK_SUPPORT_CHANNEL=#votebot-support
